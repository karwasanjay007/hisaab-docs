@startuml j11-languages
!include c4-sequence.iuml
title J11 Languages, right to left and native digits
actor "Owner" as O <<person>>
box "Hisaab in the browser"
participant "Language box\n(app.js)" as H <<container>>
participant "More languages\n(langs.js)" as G <<component>>
participant "Language file\n(i18n, on the site)" as I <<container>>
participant "Names\n(names.js)" as N <<component>>
participant "Layout\n(compact.js)" as L <<component>>
database "Browser storage\n(localStorage)" as S <<store>>
end box
== A built-in language ==
O -> H : choose Hindi in the language box of the top bar
H -> S : save the chosen language
H --> O : every label, message and reminder in Hindi;\neach name also in Hindi in brackets
O -> H : in "Shop settings" tick the box for Hindi or Telugu digits,\npress "Save settings"
H -> S : save the choice with the shop
H --> O : amounts and counts in Hindi digits
== A language fetched when chosen ==
O -> H : choose Urdu in the language box
G -> I : fetch the Urdu file from the site itself
alt the file is fetched
  I --> G : the texts; a missing one stays in English
  N --> O : each name also in Urdu script in brackets
  L --> O : the page reads right to left;\namounts and balances keep their left to right order
  note right of L : numbers stay left to right\neven on a right to left page
else the file cannot be fetched
  G --> O : "That language could not be loaded. Showing English."
end
@enduml
