@startuml j11-languages
title J11 Languages, right to left and native digits
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam shadowing false
skinparam maxMessageSize 260
skinparam titleFontSize 17
skinparam titleFontColor #0E5C45
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #0E5C45
  LifeLineBorderColor #7FA89A
  LifeLineBackgroundColor #E8F2EE
  ParticipantBorderColor #0E5C45
  ParticipantBackgroundColor #E8F2EE
  ParticipantFontColor #0B3D2E
  ActorBorderColor #0E5C45
  ActorBackgroundColor #E8F2EE
  ActorFontColor #0B3D2E
  GroupBorderColor #0E5C45
  GroupHeaderFontColor #0E5C45
  GroupBackgroundColor #F3F8F6
  DividerBorderColor #0E5C45
  DividerBackgroundColor #E8F2EE
  DividerFontColor #0B3D2E
  BoxBorderColor #0E5C45
}
skinparam database {
  BorderColor #0E5C45
  BackgroundColor #E8F2EE
}
skinparam note {
  BorderColor #B08A2E
  BackgroundColor #FFF8E6
  FontSize 12
}
actor "Owner" as O
participant "Language box\n(app.js)" as H
participant "More languages\n(langs.js)" as G
participant "Language file\n(i18n, on the site)" as I
participant "Names\n(names.js)" as N
participant "Layout\n(compact.js)" as L
database "Browser storage" as S
autonumber
== A built-in language ==
O -> H : choose हिंदी in the language box of the top bar
H -> S : save the chosen language
H --> O : every label, message and reminder in Hindi;\neach name also in Hindi in brackets
O -> H : in "Shop settings" tick the box for Hindi or Telugu digits,\npress "Save settings"
H -> S : save the choice with the shop
H --> O : amounts and counts in Hindi digits
== A language fetched when chosen ==
O -> H : choose اردو in the language box
G -> I : fetch the Urdu file from the site itself
I --> G : the texts; a missing one stays in English
N --> O : each name also in Urdu script in brackets
L --> O : the page reads right to left;\namounts and balances keep their left to right order
opt the file cannot be fetched
  G --> O : "That language could not be loaded. Showing English."
end
@enduml
