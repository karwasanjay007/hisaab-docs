@startuml j8-payment-screenshot
title J8 Payment screenshot kept with an entry
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam shadowing false
skinparam maxMessageSize 280
skinparam titleFontSize 17
skinparam titleFontColor #0E5C45
skinparam sequenceMessageAlign left
skinparam sequence {
  ArrowColor #0E5C45
  LifeLineBorderColor #7FA89A
  ParticipantBorderColor #0E5C45
  ParticipantBackgroundColor #E8F2EE
  ActorBorderColor #0E5C45
  ActorBackgroundColor #E8F2EE
  GroupBorderColor #0E5C45
  GroupBackgroundColor #F3F8F6
}
skinparam database {
  BorderColor #0E5C45
  BackgroundColor #E8F2EE
}
skinparam note {
  BorderColor #B08A2E
  BackgroundColor #FFF8E6
  FontSize 12
}
actor "Shop owner" as Owner
participant "React page\n(App.tsx)" as UI
participant "lib/images" as Img
participant "Shop store\n(useShopStore)" as Store
database "localStorage" as LS

Owner -> UI : on a customer's page fills the entry form,\nchooses a picture in #shot-input, presses Save
UI -> UI : keeps a reference to the form, reads the fields
UI -> Img : resizeToDataUrl(file)
Img -> Img : FileReader, then an Image, then a canvas
Img -> Img : fitInside: longest side at most 600 px, never enlarged;\nwhite background; JPEG at quality 0.75
loop data URL above 150,000 characters and quality above 0.35
  Img -> Img : lowers the quality by 0.1 and encodes again
end
alt the file cannot be read as a picture
  Img --> UI : error
  UI --> Owner : "could not read the image"; nothing saved
else resized
  Img --> UI : JPEG data URL
  UI -> Store : addEntry({phone, type, amount, date, note, shot})
  Store -> LS : commit(): setItem("hisaab-shop-v2")
  alt the browser's store is full
    Store -> Store : puts the ledger back as it was
    Store --> UI : storageFull
    UI --> Owner : the message; the entry is not shown as saved
  else written
    UI --> Owner : form cleared; the entry shows a small picture ([data-shot])
  end
end
note over UI, Img
  The picture never leaves the browser. 2.0.1.0 does not read the amount from the picture.
end note
@enduml
