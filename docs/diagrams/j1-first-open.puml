@startuml j1-first-open
title J1 First open
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam shadowing false
skinparam maxMessageSize 260
skinparam titleFontSize 17
skinparam titleFontColor #0E5C45
skinparam sequenceMessageAlign left
skinparam sequence {
  ArrowColor #0E5C45
  LifeLineBorderColor #7FA89A
  ParticipantBorderColor #0E5C45
  ParticipantBackgroundColor #E8F2EE
  ActorBorderColor #0E5C45
  ActorBackgroundColor #E8F2EE
  GroupBorderColor #0E5C45
  GroupBackgroundColor #F3F8F6
}
skinparam database {
  BorderColor #0E5C45
  BackgroundColor #E8F2EE
}
skinparam note {
  BorderColor #B08A2E
  BackgroundColor #FFF8E6
  FontSize 12
}
actor "Shop owner" as Owner
participant "React page\n(main.tsx, App.tsx)" as UI
participant "Shop store\n(useShopStore)" as Store
participant "lib/legacy" as Legacy
database "localStorage" as LS
participant "Service worker\n(sw.js)" as SW

Owner -> UI : opens the address, optionally with ?today=YYYY-MM-DD
UI -> Store : module loads: carryOverVersion1()
Store -> LS : getItem("hisaab-shop-v2")
alt nothing saved by this version, and version 1 left a ledger
  Store -> Legacy : legacyToV2(readKey("hisaab.v1"))
  Legacy --> Store : customers and entries that pass the checks; broken rows skipped
  Store -> LS : setItem("hisaab-shop-v2", {state, version: 0})
  note right of LS : hisaab.v1 is left as it was
else this version already has data, or there is nothing to carry
  Store -> Store : no change
end
Store -> LS : persist reads hisaab-shop-v2
LS --> Store : shop, customers, entries, shopUpi (or nothing: empty ledger)
UI -> LS : useLang: hisaab-lang, else hisaab.lang, else English
UI -> LS : useTheme: hisaab-theme, else hisaab.theme, else the system's setting
UI -> UI : today = todayFromUrl(?today=) or the calendar date
UI --> Owner : home view: total outstanding, search, customers by highest balance\n(or the empty-ledger line), CSV buttons, Add customer form, import box
opt built site
  UI -> SW : register("/sw.js")
  SW -> SW : activate: delete every cache except hisaab-v20, claim the page
  UI -> SW : postMessage({cache: addresses already loaded})
  SW -> SW : stores a copy of each same-origin address
end
@enduml
