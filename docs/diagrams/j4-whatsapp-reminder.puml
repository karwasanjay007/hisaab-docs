@startuml j4-whatsapp-reminder
title J4 WhatsApp reminder with the pay link, and other ways to send
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam shadowing false
skinparam maxMessageSize 260
skinparam titleFontSize 17
skinparam titleFontColor #0E5C45
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #0E5C45
  LifeLineBorderColor #7FA89A
  LifeLineBackgroundColor #E8F2EE
  ParticipantBorderColor #0E5C45
  ParticipantBackgroundColor #E8F2EE
  ParticipantFontColor #0B3D2E
  ActorBorderColor #0E5C45
  ActorBackgroundColor #E8F2EE
  ActorFontColor #0B3D2E
  GroupBorderColor #0E5C45
  GroupHeaderFontColor #0E5C45
  GroupBackgroundColor #F3F8F6
  DividerBorderColor #0E5C45
  DividerBackgroundColor #E8F2EE
  DividerFontColor #0B3D2E
  BoxBorderColor #0E5C45
}
skinparam database {
  BorderColor #0E5C45
  BackgroundColor #E8F2EE
}
skinparam note {
  BorderColor #B08A2E
  BackgroundColor #FFF8E6
  FontSize 12
}
actor "Owner" as O
participant "Home screen\n(app.js)" as H
participant "Customer page\n(sendways.js, wacheck.js)" as C
database "Browser storage" as S
participant "WhatsApp" as WA
actor "Customer" as K
participant "Pay page\n(pay.html)" as P
participant "UPI app" as U
autonumber
== The reminder ==
O -> H : tap the WhatsApp button on a customer's row
H -> WA : open a chat with +91 and the customer's number; the message is typed in:\nname, shop, balance, "UPI pay link" and "Pay by UPI"
note right of WA : this leaves the device only when\nthe owner presses Send
O -> WA : press Send in WhatsApp
== The customer pays ==
K -> P : tap the "UPI pay link" in the message
P --> K : "Pay to", the shop, the amount,\n"Open your UPI app" and "Copy"
P -> U : on a phone, open the UPI app with the amount filled in
== When WhatsApp cannot reach the number ==
O -> C : open the customer, open "Other ways to send"
C --> O : "Send as SMS", "Choose a contact in WhatsApp",\n"Copy the message": the same message
O -> C : tap "Check on WhatsApp"
C -> WA : open a chat with a short hello message
O -> C : answer "Yes, the chat opened" or\n"No, it said the number is not on WhatsApp"
C -> S : keep the answer for this number
C --> O : "Checked: this number is on WhatsApp." or\n"Not on WhatsApp. Send by SMS, or change the number."
== A shop with no UPI ID of its own ==
C --> O : "Reminders now ask customers to pay the demo UPI ID\nhisaab.demo@upi, not your shop." with "Set your shop's UPI ID"
@enduml
