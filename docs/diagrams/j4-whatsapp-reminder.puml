@startuml j4-whatsapp-reminder
!include c4-sequence.iuml
title J4 WhatsApp reminder with the pay link, and other ways to send
actor "Owner" as O <<person>>
box "Hisaab in the browser"
participant "Home screen\n(app.js)" as H <<container>>
participant "Customer page\n(sendways.js,\nwacheck.js)" as C <<component>>
database "Browser storage\n(localStorage)" as S <<store>>
end box
participant "WhatsApp" as WA <<external>>
actor "Customer" as K <<person>>
participant "Pay page\n(pay.html)" as P <<container>>
participant "UPI app" as U <<external>>
== The reminder ==
O -> H : tap the WhatsApp button\non a customer's row
H -> WA : open a chat with +91 and the customer's number;\nthe message is typed in: name, shop, balance,\n"UPI pay link" and "Pay by UPI"
note over WA : nothing is sent until\nthe owner presses Send\nin WhatsApp
O -> WA : press Send in WhatsApp
== The customer pays ==
K -> P : tap the "UPI pay link"\nin the message
P --> K : "Pay to", the shop,\nthe amount, "Open your\nUPI app" and "Copy"
P -> U : on a phone, open\nthe UPI app with\nthe amount filled in
note over P, U : the money goes from the\ncustomer's UPI app to the shop;\nHisaab never handles it
== When WhatsApp cannot reach the number ==
O -> C : open the customer, open "Other ways to send"
C --> O : "Send as SMS", "Choose a contact\nin WhatsApp", "Copy the message":\nthe same message
O -> C : tap "Check on WhatsApp"
C -> WA : open a chat with a short hello message
O -> C : answer "Yes, the chat opened" or\n"No, it said the number is\nnot on WhatsApp"
C -> S : keep the answer\nfor this number
C --> O : "Checked: this number is on WhatsApp."\nor "Not on WhatsApp. Send by SMS,\nor change the number."
opt the shop has no UPI ID of its own
  C --> O : "Reminders now ask customers\nto pay the demo UPI ID\nhisaab.demo@upi, not your shop."\nwith "Set your shop's UPI ID"
end
@enduml
