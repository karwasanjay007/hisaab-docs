@startuml j7-import-export
title J7 Load a shop file or CSV (replace, with Undo) and export CSV and JSON
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam shadowing false
skinparam maxMessageSize 260
skinparam titleFontSize 17
skinparam titleFontColor #0E5C45
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #0E5C45
  LifeLineBorderColor #7FA89A
  LifeLineBackgroundColor #E8F2EE
  ParticipantBorderColor #0E5C45
  ParticipantBackgroundColor #E8F2EE
  ParticipantFontColor #0B3D2E
  ActorBorderColor #0E5C45
  ActorBackgroundColor #E8F2EE
  ActorFontColor #0B3D2E
  GroupBorderColor #0E5C45
  GroupHeaderFontColor #0E5C45
  GroupBackgroundColor #F3F8F6
  DividerBorderColor #0E5C45
  DividerBackgroundColor #E8F2EE
  DividerFontColor #0B3D2E
  BoxBorderColor #0E5C45
}
skinparam database {
  BorderColor #0E5C45
  BackgroundColor #E8F2EE
}
skinparam note {
  BorderColor #B08A2E
  BackgroundColor #FFF8E6
  FontSize 12
}
actor "Shop owner" as Owner
participant "Browser UI\n(index.html)" as UI
participant "app.js" as App
database "localStorage" as LS
autonumber
== Load a shop ==
alt paste
  Owner -> UI : paste the shop JSON or a CSV into #import-box, press Load (#import-go)
  UI -> App : click: doImport()
else choose a file
  Owner -> UI : #import-file (.json, .csv, .txt)
  UI -> App : FileReader text into #import-box, then doImport()
else load the sample again
  Owner -> UI : #load-sample
  UI -> App : fetch('sample-data.json', no-store) into #import-box, then doImport()\n(built-in sample if the fetch fails)
end
alt box empty
  App -> UI : #import-msg "The file needs customers and entries lists."
else text starts with { or [ but is not valid JSON
  App -> UI : #import-msg "This is not valid JSON: " + the parser's message
else any other text: fromCsv() finds no phone column, or no amount, credit,\npayment or name column
  App -> UI : #import-msg errCsv "Paste a shop file (JSON) or a spreadsheet saved as CSV..."
else fromShopFile(obj) throws
  App -> UI : #import-msg: no customers[] or entries[] arrays,\nor no valid customer (first three problems listed)
  note right of App : nothing is replaced
else valid
  opt CSV text
    App -> App : csvRows(); fromCsv(): headers matched by meaning; a row gives a typed entry\nand/or credit and payment entries; the current shop name is kept
  end
  App -> App : fromShopFile(obj): phone10(); 10 digit phones; duplicates dropped;\ntypes udhar, sale, debit = credit; paid, jama, receipt = payment;\namounts without Rs, commas; amount missing, not a number, negative or\nabove 10,000,000 skipped; dates YYYY-MM-DD or DD/MM/YYYY, missing or\nunreadable dated today and counted; a bad UPI ID skipped (current one kept);\ncustomers created from entries when missing; bad rows skipped
  App -> App : snapshot: lastShop = JSON.stringify(state)
  App -> App : state = the new shop (replaces, never merges)
  App -> LS : save(): setItem('hisaab.v1', state)
  App -> App : resetEntryForm(); hash to #/; clear search; render()
  App -> UI : #import-msg "Loaded {shop}: {c} customers, {e} entries" + "{n} entries had no date\nand are dated today." + "Skipped {n}: ..." when rows were dropped
  App -> UI : toast "Shop loaded." with Undo (7 s)
  note right of UI : no confirm dialog
  alt Undo within 7 s
    Owner -> UI : tap Undo (#toast-undo)
    UI -> App : state = JSON.parse(lastShop)
    App -> LS : save()
    App -> UI : render(): the previous shop is back
  else 7 s pass
    App -> App : hide the toast; lastShop = null
  end
end
== Export ==
alt Entries CSV (#export-csv)
  Owner -> UI : tap
  UI -> App : exportEntries(): date, name, phone, type, amount, note, has_screenshot;\noldest first
else Balances CSV (#export-balances)
  Owner -> UI : tap
  UI -> App : exportBalances(): name, phone, total_credit, total_payment, balance,\nlast_payment, then a TOTAL OUTSTANDING row
else Shop file JSON (#export-json)
  Owner -> UI : tap
  UI -> App : exportJson(): shop, upi, customers, entries\n(phone, type, amount, date, note; no screenshots)
end
note right of App : csvCell(): text that starts with = + - @ gets a leading quote
App -> UI : download(): Blob, a[download] hisaab-{shop}-entries.csv,\n-balances.csv or hisaab-{shop}.json
UI --> Owner : file saved by the browser
@enduml
