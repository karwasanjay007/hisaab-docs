@startuml j9-shops-and-profile
!include c4-sequence.iuml
title J9 Several shops and the shop profile
actor "Owner" as O <<person>>
box "Hisaab in the browser"
participant "The + menu\n(compact.js)" as M <<component>>
participant "Shops\n(shops.js)" as X <<component>>
participant "Shop settings\n(app.js)" as H <<container>>
participant "Shop profile\n(profile.js)" as F <<component>>
database "Browser storage\n(localStorage)" as S <<store>>
end box
== Several shops ==
O -> M : tap "+", then "Shops"
O -> X : type a name under "Add a new shop", press "Add shop"
X -> S : set the open shop aside and start an empty one
X --> O : "Added "{name}". It is now the current shop."
note right of S : each shop is kept apart;\nonly the open shop is shown
O -> X : press "Switch" beside the first shop
X -> S : set this shop aside and open the other
X --> O : "Switched to "{name}"."
O -> X : press "Remove" beside a shop that is not open,\nthen "Press again to remove"
note over X : the open shop cannot be removed;\nremoving asks twice
X --> O : "Removed "{name}"."
== Shop settings and profile ==
O -> M : tap "+", then "Shop settings"
O -> H : type "Shop name" and "Shop UPI ID (for pay links)",\npress "Save settings"
H -> S : save; every reminder and pay link uses the new UPI ID
O -> M : tap "+", then "Shop profile"
O -> F : type "Owner name" and "Shop address", choose a "Shop logo",\npress "Save profile"
F -> S : save the profile with the shop
F --> O : "Profile saved."; the logo shows in the top bar and on statements
@enduml
