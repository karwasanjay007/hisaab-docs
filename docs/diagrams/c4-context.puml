@startuml c4-context
!include <C4/C4_Context>
title Hisaab 2.0.1.0: system context (C4 level 1)

Person(owner, "Shop owner", "Keeps the shop's credit ledger on a phone or a desktop browser")
Person_Ext(customer, "Customer", "Buys on credit; receives the reminder in WhatsApp")

System(hisaab, "Hisaab", "Shop credit ledger. A single page that runs in the browser: customers, credit and payment entries, balances, an overdue list, reminders, CSV export. No server, no account, no AI")

System_Ext(host, "Static hosting", "Serves the built files over HTTPS")
System_Ext(whatsapp, "WhatsApp", "Opened by a wa.me link with the reminder text filled in")
System_Ext(upi, "UPI app", "Opens the upi://pay address written in the reminder text")

Rel(owner, hisaab, "Adds customers and entries, reads balances, taps Remind, exports CSV")
Rel(hisaab, host, "Loads the page, scripts, styles and fonts", "HTTPS, first visit and updates")
Rel(hisaab, whatsapp, "Opens a chat with the reminder text", "https://wa.me link in a new tab")
Rel(owner, whatsapp, "Presses Send")
Rel(whatsapp, customer, "Delivers the reminder")
Rel(customer, upi, "Uses the upi://pay address from the message")

SHOW_LEGEND()
@enduml
