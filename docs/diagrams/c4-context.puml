@startuml c4-context
!include <C4/C4_Context>
title Hisaab: system context (C4 level 1)

Person(owner, "Shop owner", "Runs a small shop; records credit and payments on a phone or a computer and sends reminders")
Person(customer, "Customer", "Buys on credit; receives a reminder and pays by UPI")

System(hisaab, "Hisaab", "Shop credit ledger that runs in the browser. It has no server of its own: everything a shop records stays in the browser of the device")

System_Ext(hosting, "Static hosting", "Serves the files of the site at hisaab-hazel.vercel.app; receives no ledger data")
System_Ext(whatsapp, "WhatsApp", "Opens a chat from a wa.me link with the message already written")
System_Ext(sms, "SMS app", "Opens an sms: link with the reminder already written")
System_Ext(dialer, "Phone dialer", "Opens a tel: link to call the customer")
System_Ext(upi, "UPI app", "Opens a upi://pay link or scans the QR code to pay the shop")
System_Ext(jsdelivr, "jsDelivr", "Serves the screenshot reader, Tesseract.js 5.1.1, when a screenshot is chosen")
System_Ext(speech, "Browser's speech service", "Turns speech into text when the microphone button is pressed; run by the browser maker")

Rel(owner, hisaab, "Records entries, checks balances, sends reminders", "browser")
Rel(hosting, hisaab, "Serves the static files", "HTTPS")
Rel(hisaab, whatsapp, "Reminder, receipt, hello message or plain chat, only when the owner taps", "wa.me link")
Rel(hisaab, sms, "The reminder as an SMS, only when the owner taps", "sms: link")
Rel(hisaab, dialer, "Call link on the customer page", "tel: link")
Rel(hisaab, upi, "Pay link, pay page and QR code", "upi://pay link")
Rel(hisaab, jsdelivr, "Fetches the reader script when a screenshot is chosen", "HTTPS")
Rel(hisaab, speech, "The spoken audio, sent by the browser while the microphone is on")
Rel(whatsapp, customer, "Delivers the message the owner sends")
Rel(sms, customer, "Delivers the SMS the owner sends")
Rel(customer, upi, "Pays the amount shown")

LAYOUT_WITH_LEGEND()
@enduml
