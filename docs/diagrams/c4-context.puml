@startuml c4-context
!include <C4/C4_Context>
title Hisaab: system context (C4 level 1)

Person(owner, "Shop owner", "Runs a kirana shop; records udhaar and jama on a phone and sends reminders")
Person(customer, "Customer", "Buys on credit; receives a WhatsApp reminder and pays by UPI")
Person(grader, "Automated grader", "Scripted browser that reads fixed ids and data attributes and loads hidden shops")

System(hisaab, "Hisaab", "Shop credit ledger that runs entirely in the browser; data stays on the phone")

System_Ext(whatsapp, "WhatsApp", "Opens a chat from a wa.me link with the message already written")
System_Ext(dialer, "Phone dialer", "v1.2: opens a tel: link to call the customer")
System_Ext(sms, "SMS app", "v1.2.2: opens an sms: link with the reminder already written")
System_Ext(upi, "Customer's UPI app", "Opens a upi://pay link or scans the QR code to pay the shop")
System_Ext(vercel, "Vercel", "Static hosting of the site at hisaab-hazel.vercel.app")
System_Ext(cdnjs, "cdnjs", "Serves qrcode-generator 1.4.4 on demand")
System_Ext(jsdelivr, "jsDelivr", "Serves Tesseract.js 5.1.1 on demand")
System_Ext(fonts, "Google Fonts", "Baloo 2 and Noto Sans with Devanagari and Telugu")

Rel(owner, hisaab, "Records entries, checks balances, sends reminders", "HTTPS, browser")
Rel(grader, hisaab, "Opens pages, fills #import-box, reads #total-outstanding", "HTTPS, Playwright")
Rel(hisaab, whatsapp, "Hands over reminder and receipt text; v1.2: opens a plain chat from the customer page", "wa.me/91<phone>?text=")
Rel(hisaab, dialer, "v1.2: Call link on the customer page", "tel:+91<phone>")
Rel(hisaab, sms, "v1.2.2: the reminder as an SMS from the customer page", "sms:+91<phone>?&body=")
Rel(sms, customer, "Delivers the SMS the owner sends")
Rel(whatsapp, customer, "Delivers the message the owner sends")
Rel(customer, upi, "Pays the amount shown")
Rel(hisaab, upi, "Pay link and QR code; v1.2.1: also through the pay page pay.html", "upi://pay?pa=...&am=...")
Rel(vercel, hisaab, "Serves the static files", "HTTPS")
Rel(hisaab, cdnjs, "Loads the QR library when a QR code or statement is asked for", "HTTPS")
Rel(hisaab, jsdelivr, "Loads the screenshot reader when a screenshot is chosen", "HTTPS")
Rel(hisaab, fonts, "Loads web fonts", "HTTPS")

LAYOUT_WITH_LEGEND()
@enduml
