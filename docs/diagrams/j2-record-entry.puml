@startuml j2-record-entry
title J2 Add a customer; record a credit or payment; edit; delete with Undo
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam shadowing false
skinparam maxMessageSize 260
skinparam titleFontSize 17
skinparam titleFontColor #0E5C45
skinparam sequenceMessageAlign left
skinparam sequence {
  ArrowColor #0E5C45
  LifeLineBorderColor #7FA89A
  ParticipantBorderColor #0E5C45
  ParticipantBackgroundColor #E8F2EE
  ActorBorderColor #0E5C45
  ActorBackgroundColor #E8F2EE
  GroupBorderColor #0E5C45
  GroupBackgroundColor #F3F8F6
  DividerBorderColor #0E5C45
  DividerBackgroundColor #E8F2EE
}
skinparam database {
  BorderColor #0E5C45
  BackgroundColor #E8F2EE
}
skinparam note {
  BorderColor #B08A2E
  BackgroundColor #FFF8E6
  FontSize 12
}
actor "Shop owner" as Owner
participant "React page\n(App.tsx)" as UI
participant "Shop store\n(useShopStore)" as Store
participant "lib/ledger" as Ledger
database "localStorage" as LS

== Add a customer ==
Owner -> UI : name and 10-digit phone, Save
UI -> Store : addCustomer(name, phone)
alt name empty, phone not 10 digits, or phone already used
  Store --> UI : errName, errPhone or errPhoneDup
  UI --> Owner : the message under the form; nothing saved
else accepted
  Store -> LS : commit(): setItem("hisaab-shop-v2")
  UI --> Owner : status "customer added"; the row appears
end

== Record an entry ==
Owner -> UI : opens the customer, chooses credit or payment,\namount, date (today by default), note, Save
UI -> Store : addEntry({phone, type, amount, date, note})
alt amount not a whole number above 0, or date not YYYY-MM-DD
  Store --> UI : errAmount or errDate
  UI --> Owner : the message in the form; nothing saved
else accepted
  Store -> Ledger : newId()
  Store -> LS : commit(): setItem("hisaab-shop-v2")
  alt the browser's store is full
    Store -> Store : puts the ledger back as it was
    Store --> UI : storageFull
  else written
    UI -> Ledger : balanceOf, totalOutstanding, entriesNewestFirst
    UI --> Owner : form cleared; entry on top; balance and total updated
  end
end

== Edit ==
Owner -> UI : Edit on an entry, changes type, amount, date or note, Save
UI -> Store : updateEntry(id, patch)
Store -> LS : commit()
UI --> Owner : status "entry updated"; balances recomputed

== Delete with Undo ==
Owner -> UI : Delete on an entry
UI -> Store : deleteEntry(id)
Store -> LS : commit(): entry removed, lastDeleted kept in memory
UI --> Owner : status "entry deleted" with an Undo button
opt Owner presses Undo
  UI -> Store : undoDelete()
  Store -> LS : commit(): entry back, lastDeleted cleared
  UI --> Owner : status "entry restored"
end
@enduml
