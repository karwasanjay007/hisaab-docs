@startuml deployment
!include <C4/C4_Deployment>
title Hisaab: deployment

skinparam wrapWidth 190
skinparam maxMessageSize 160

Deployment_Node(repo, "Source repository", "Git") {
  Container(src, "App folder", "Files", "The site's files plus the brief, brand, tests and notes; .vercelignore keeps those last ones out of the deploy")
}
Deployment_Node(vc, "Vercel", "Static hosting") {
  Deployment_Node(edge, "hisaab-hazel.vercel.app", "HTTPS") {
    Container(site, "Static site", "HTML, CSS, JavaScript, JSON, SVG, WOFF2", "index.html, pay.html, app.js and the add-on scripts, the style sheets, sample-data.json, sw.js, manifest.webmanifest, icon.svg, brand-mark.svg, vendor/, fonts/, i18n/. No build step, no rewrites, no functions, no server code")
  }
}
Deployment_Node(device, "Owner's phone or computer", "Browser") {
  Container(app, "Hisaab page", "HTML, CSS, JavaScript", "Runs the whole ledger in the browser")
  ContainerDb(store, "localStorage", "Web Storage", "Everything the shop records. It is never uploaded")
  Container(swk, "Service worker", "sw.js", "Network first; falls back to the cache hisaab-v22")
  ContainerDb(cache, "Cache hisaab-v22", "Cache API", "Copies of the site's files for use offline")
}
Deployment_Node(out, "Reached only when used", "Other parties") {
  Container(cdn, "jsDelivr", "CDN", "The screenshot reader, fetched when a screenshot is chosen")
  Container(speech, "Browser's speech service", "Browser maker", "Receives the audio while the microphone is on")
  Container(apps, "WhatsApp, SMS, dialer, UPI app", "Apps on the device", "Opened by links the owner taps")
}

Rel(src, site, "vercel deploy --prod", "Vercel CLI")
Rel(app, site, "Loads the files; fetches i18n/<code>.json only for a chosen language", "HTTPS")
Rel(app, store, "Reads and writes")
Rel(app, swk, "Registers on HTTPS or localhost")
Rel(swk, site, "Network first", "HTTPS")
Rel(swk, cache, "Stores and reads copies")
Rel(app, cdn, "Reader script", "HTTPS")
Rel(app, speech, "Audio, by the browser")
Rel(app, apps, "wa.me, sms:, tel:, upi://pay links")

LAYOUT_LEFT_RIGHT()
SHOW_LEGEND()
@enduml
