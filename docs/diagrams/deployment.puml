@startuml deployment
!include <C4/C4_Deployment>
title Hisaab 2.0.1.0: deployment

Deployment_Node(dev, "Developer PC", "Node.js, npm, hosting CLI") {
  Container(src, "Working copy", "Git", "src/, public/, index.html, tests, fixtures; legacy/ holds the version 1 code, which is not built")
  Container(build, "Build", "npm run build: tsc -b, then vite build", "Writes dist/: index.html, assets/ (hashed script, style and font files), icon.svg, sw.js")
}
Deployment_Node(gh, "Git hosting", "Private repository") {
  Container(repo, "Code repository", "Git", "Source history")
}
Deployment_Node(vc, "Static hosting", "HTTPS") {
  Container(site, "Static site", "HTML, JavaScript, CSS, fonts, SVG", "The contents of dist/. vercel.json: build command npm run build, output dist, every address rewritten to /index.html. No functions, no server code, no database")
}
Deployment_Node(phone, "Owner's phone or PC", "Browser") {
  Container(app, "Hisaab page", "React 19", "Runs the whole ledger in the browser")
  ContainerDb(store, "localStorage", "Web Storage", "hisaab-shop-v2, hisaab-lang, hisaab-theme. The shop's data is never uploaded")
  Container(swk, "Service worker", "sw.js, cache hisaab-v20", "Keeps a copy of what the page loaded; network first; removes older caches")
}

Rel(src, repo, "git push", "HTTPS")
Rel(src, build, "npm run build")
Rel(build, site, "Production deploy", "hosting CLI")
Rel(app, site, "Loads the page and its files", "HTTPS")
Rel(app, store, "Reads and writes", "getItem, setItem")
Rel(app, swk, "Registers; sends the loaded addresses")
Rel(swk, site, "Network first, stored copy offline", "HTTPS")

SHOW_LEGEND()
@enduml
