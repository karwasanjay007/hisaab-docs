@startuml j5-overdue-list
title J5 Overdue list
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam shadowing false
skinparam maxMessageSize 280
skinparam titleFontSize 17
skinparam titleFontColor #0E5C45
skinparam sequenceMessageAlign left
skinparam sequence {
  ArrowColor #0E5C45
  LifeLineBorderColor #7FA89A
  ParticipantBorderColor #0E5C45
  ParticipantBackgroundColor #E8F2EE
  ActorBorderColor #0E5C45
  ActorBackgroundColor #E8F2EE
  GroupBorderColor #0E5C45
  GroupBackgroundColor #F3F8F6
}
skinparam note {
  BorderColor #B08A2E
  BackgroundColor #FFF8E6
  FontSize 12
}
actor "Shop owner" as Owner
participant "React page\n(App.tsx)" as UI
participant "lib/csv" as Csv
participant "lib/ledger" as Ledger

Owner -> UI : taps Overdue in the bottom navigation
UI -> Csv : overdueList(customers, today, daysSinceLastPayment)
loop each customer
  Csv -> Ledger : balanceOf(customer)
  alt balance above 0
    Csv -> Ledger : daysSinceLastPayment(customer, today)
    Ledger --> Csv : days since the latest payment;\nnever paid: days since the first entry
  else balance 0 or an advance
    Csv -> Csv : left out
  end
end
Csv --> UI : list sorted by most days first, then by name
alt nobody owes
  UI --> Owner : "nothing overdue" line
else
  UI --> Owner : each row: name, days, balance
  opt Owner taps a row
    UI --> Owner : that customer's page (J2); the Remind link is on the home view (J4)
  end
end
note over UI, Ledger
  today comes from ?today=YYYY-MM-DD when given, else the calendar date.
  There is no day threshold and no send-to-all queue in 2.0.1.0.
end note
@enduml
