@startuml data-model
title Hisaab 2.0.1.0 data model (browser localStorage)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 14
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam titleFontColor #0E5C45
skinparam ArrowColor #0E5C45
skinparam ArrowFontColor #33413C
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0E5C45
  HeaderBackgroundColor #E6F1ED
  FontColor #14211C
  AttributeFontColor #33413C
}
skinparam note {
  BackgroundColor #F5F8F6
  BorderColor #9DB8AD
  FontSize 12
}
hide circle
hide methods

package "key hisaab-shop-v2 (written by the store's persist)" {
  class Envelope {
    state : ShopData
    version : 0
  }
  class ShopData {
    shop : string, may be empty
    shopUpi : string, may be empty
    customers : Customer[]
    entries : Entry[]
  }
  class Customer {
    name : string, not empty
    phone : string, 10 digits, unique
  }
  class Entry {
    id : string
    phone : string, a customer's phone
    type : "credit" or "payment"
    amount : whole rupees, above 0
    date : YYYY-MM-DD
    note : string, may be empty
    shot : JPEG data URL, optional
  }
}

class "key hisaab-lang" as Lang {
  "en", "hi" or "te"
}
class "key hisaab-theme" as Theme {
  "light" or "dark"
}
class "Version 1 keys (read once, never changed)" as Old {
  hisaab.v1 : the 1.x ledger
  hisaab.lang
  hisaab.theme
}
class "In memory only" as Mem {
  lastDeleted : Entry or nothing
  statusMessage : string
  importError : string
}

Envelope *-- ShopData
ShopData *-- "0..*" Customer
ShopData *-- "0..*" Entry
Customer "1" <-- "0..*" Entry : phone
Old ..> ShopData : carried over on first open\nwhen hisaab-shop-v2 is absent

note bottom of Entry
  No balance is stored.
  Balance = sum of signedAmount(entry):
  credit adds, payment takes away.
end note
note bottom of Mem
  Not written to storage:
  Undo is lost on reload.
end note
@enduml
