@startuml data-model
title Hisaab data model (browser localStorage)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 14
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam titleFontColor #0E5C45
skinparam ArrowColor #0E5C45
skinparam ArrowFontColor #33413C
skinparam ArrowThickness 1.4
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #0E5C45
  BorderThickness 1.6
  HeaderBackgroundColor #E6F1ED
  FontColor #14211C
  AttributeFontColor #33413C
  StereotypeFontColor #0E5C45
}
skinparam note {
  BackgroundColor #F5F8F6
  BorderColor #9DB8AD
  FontColor #33413C
  FontSize 12
}
skinparam package {
  BorderColor #9DB8AD
  FontColor #0E5C45
  BackgroundColor #FFFFFF
}
hide circle
hide methods
set separator none

package "localStorage key hisaab.v1 (the open shop, one JSON document)" {
  class Shop <<root>> {
    shop : string
    {field} upi : string  (empty = demo ID)
    nativeDigits : boolean [optional]
    {field} owner : string  (at most 60) [optional]
    {field} address : string  (at most 160) [optional]
    {field} logo : data:image/ URL  (under 40 KB) [optional]
    customers : Customer[]
    entries : Entry[]
  }

  class Customer {
    {field} <b>phone</b> : string  (10 digits, key)
    name : string
    name_hi : string [optional]
    name_te : string [optional]
  }

  class Entry {
    {field} <b>id</b> : string  (key)
    {field} phone : string  (refers to Customer)
    type : credit | payment
    {field} amount : number  (whole rupees)
    date : YYYY-MM-DD
    note : string
    shot : JPEG data URL | null
    {field} seq : integer  (same-date order)
  }
}

package "localStorage keys hisaab.lang, hisaab.theme, hisaab.guard" {
  class Preferences <<per browser>> {
    {field} hisaab.lang : en, hi, te, bn, mr, ta, gu, kn, ml, pa, or, ur
    hisaab.theme : light | dark
    {field} hisaab.guard : test write  (removed at once)
  }
}

package "localStorage key hisaab.shops (only with two or more shops)" {
  class Shops <<one per browser>> {
    {field} active : string  (id of the open shop)
    list : ShopSlot[]
  }

  class ShopSlot {
    {field} <b>id</b> : string  (key)
    name : string
    {field} data : Shop | null  (null = the open shop)
  }
}

package "localStorage key hisaab.wa" {
  class WaChecks <<one per browser>> {
    {field} <b>number</b> : string  (10 digits, key)
    {field} s : ok | no  (the owner's answer)
    {field} d : string  (date, YYYY-MM-DD)
  }
}

package "Cache API" {
  class "Cache hisaab-v22" as Cache <<service worker>> {
    copies of the site's own files
    no ledger data
  }
}

note bottom of WaChecks
  Keyed by number, not by shop.
  Outside hisaab.v1: not in a
  shop file or a backup file.
end note

Shops "1" *-- "1..*" ShopSlot : list
ShopSlot "1" o-- "0..1" Shop : data (parked ledger)

note bottom of ShopSlot
  The open shop's data is null: its ledger
  is under hisaab.v1. A switch parks the
  open ledger here and puts the chosen one
  under hisaab.v1. The key is not written
  until a second shop is added and is removed
  when one shop is left.
end note

Shop "1" *-- "0..*" Customer : customers
Shop "1" *-- "0..*" Entry : entries
Customer "1" -- "0..*" Entry : phone

note right of Customer
  <b>Worked out, never stored</b>
  balance = credit amounts - payment amounts
  balance > 0 : owes the shop
  balance < 0 : in advance
  days without paying (balance > 0 only) =
    today - last payment date,
    or first credit date when never paid
  overdue = 30 days or more
end note

note bottom of Entry
  <b>Balance after</b> (customer page):
  entries of one customer by date, then seq,
  oldest first; the balance after each entry.
  Shown newest first.
end note

note left of Shop
  <b>Total outstanding</b> =
  sum of all balances, so a customer
  in advance lowers it.
end note

@enduml
