@startuml data-model
!include c4-erd.iuml
title Hisaab data model: everything stays in the browser
top to bottom direction

package "Browser storage: localStorage (each device)" <<browser>> {
  entity "hisaab.v1" as shop <<document>> {
    * key "hisaab.v1" : string <<PK>>
    --
    * shop : string
    * upi : string
      nativeDigits : boolean <<NULL>>
      owner : string <<NULL>>
      address : string <<NULL>>
      logo : string <<NULL>>
    * customers : Customer[]
    * entries : Entry[]
  }

  entity "Shop settings" as settings <<record>> {
    top-level fields of hisaab.v1
    --
    * shop : string (name, at most 60 typed; "My shop")
    * upi : string (UPI ID, or "" for the demo ID)
      nativeDigits : boolean <<NULL>> (Hindi or Telugu digits)
  }

  entity "Shop profile" as profile <<record>> {
    top-level fields of hisaab.v1, from profile.js
    --
      owner : string <<NULL>> (at most 60)
      address : string <<NULL>> (at most 160)
      logo : string <<NULL>> (data:image/ URL, under 40 KB)
  }

  entity "Customer" as customer <<record>> {
    * phone : string <<PK>> (10 digits)
    --
    * name : string (at most 60 typed)
      name_hi : string <<NULL>> (Devanagari)
      name_te : string <<NULL>> (Telugu script)
  }

  entity "Entry" as entry <<record>> {
    * id : string <<PK>> ("e" + time + random, base 36)
    --
    * phone : string <<FK>> (Customer.phone)
    * type : "credit" | "payment"
    * amount : number (whole rupees)
    * date : string (YYYY-MM-DD)
    * note : string (may be "", up to 80 typed)
      shot : string <<NULL>> (JPEG data URL, or null)
    * seq : integer (order within a date)
  }

  entity "hisaab.shops" as shops <<key>> {
    * active : string <<FK>> (ShopSlot.id of the open shop)
    --
      pending : string <<NULL>> (ShopSlot.id during a switch)
    * list : ShopSlot[]
  }

  entity "ShopSlot" as slot <<record>> {
    * id : string <<PK>> ("s" + time + random, base 36)
    --
    * name : string
      data : object <<NULL>> (a whole hisaab.v1 document; null for the open shop)
  }

  entity "hisaab.wa" as wa <<key>> {
    one object, keyed by phone number
    --
    * <phone> : string <<PK>> (10 digits)
    * s : "ok" | "no" (the owner's answer)
    * d : string (YYYY-MM-DD, when answered)
  }

  entity "hisaab.lang" as lang <<key>> {
    value : string <<NULL>>
    en, hi, te, bn, mr, ta, gu, kn, ml, pa, or, ur; en when absent
  }

  entity "hisaab.theme" as theme <<key>> {
    value : "light" | "dark" <<NULL>>
    absent: follow the device
  }

  entity "hisaab.guard" as guardk <<key>> {
    value : "1"
    written and removed at once when the page opens
  }
}

package "Browser cache (service worker)" <<browser>> {
  entity "hisaab-v22" as cache <<file>> {
    the site's own files: pages, scripts, styles,
    fonts, icons, QR library, sample-data.json
    no ledger data
  }
}

package "Files" <<file>> {
  entity "hisaab-<shop>.json (shop file)" as shopfile <<file>> {
    * customers : {name, phone, name_hi?, name_te?}[]
    --
      shop : string (also read as shop_name, name)
      upi : string <<NULL>> (also read as upi_id)
      entries : {phone, type, amount, date, note, shot?, name?}[]
      owner : string <<NULL>>
      address : string <<NULL>>
      logo : string <<NULL>>
  }

  entity "hisaab-<shop>-entries.csv" as csvE <<file>> {
    date, name, phone, type, amount, note, has_screenshot (yes | no)
  }

  entity "hisaab-<shop>-balances.csv" as csvB <<file>> {
    name, phone, total_credit, total_payment, balance, last_payment
    last row: TOTAL OUTSTANDING
  }
}

shop ||--|| settings : "holds\nthe settings"
shop ||--o| profile : "holds zero or one\nprofile"
shop ||--o{ customer : "customers[]"
shop ||--o{ entry : "entries[]"
customer ||..o{ entry : "by phone,\nnot enforced"
shops ||--|{ slot : "list[]"
shop |o..o{ slot : "data: a parked copy\nof a shop document"
customer |o..o{ wa : "same phone,\nby value"
shop |o..o{ shopfile : "Backup file writes;\nLoad shop reads"
entry }o..o{ csvE : "one row\nper entry"
customer }o..o{ csvB : "one row per customer,\nbalance worked out"

settings -[hidden]right- profile
customer -[hidden]down- wa
entry -[hidden]down- shops
wa -[hidden]right- shops
slot -[hidden]down- lang
lang -[hidden]right- theme
theme -[hidden]right- guardk
lang -[hidden]down- cache
cache -[hidden]down- shopfile
shopfile -[hidden]down- csvE
csvE -[hidden]right- csvB

note right of csvB
  <b>Worked out, never stored</b>
  balance = all credit - all payments
  above 0: owes the shop; below 0: in advance
  overdue = 30 days or more without a payment
  (OVERDUE_DAYS = 30)
  amounts are whole rupees
end note

note bottom of cache
  Nothing leaves the device except what
  the owner sends: a WhatsApp or SMS message,
  a pay link, or a file the owner shares.
end note

legend bottom left
  <b>Key</b>
  PK primary key, FK foreign key
  * mandatory, NULL optional
  solid line: held inside the same document
  dotted line: linked by value only, nothing enforces it
  <b>Stores</b>
  light blue: on the device (localStorage, cache)
  grey: files the owner saves or loads
endlegend
@enduml
