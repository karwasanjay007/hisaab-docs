@startuml j10-customer-tools
!include c4-sequence.iuml
title J10 Customer tools
actor "Owner" as O <<person>>
box "Hisaab in the browser"
participant "Customer page\n(app.js)" as H <<container>>
participant "More for this customer\n(customer.js)" as C <<component>>
database "Browser storage\n(localStorage)" as S <<store>>
end box
participant "Phone app\nor WhatsApp" as T <<external>>
O -> H : tap a customer in the list
C --> O : "Total given on credit", "Total received" and\n"{n} days since the last payment" or "No payment yet"
opt the owner wants to talk to the customer
  O -> C : tap "Call" or "WhatsApp chat"
  C -> T : open the phone app with the number, or an empty WhatsApp chat
end
== Change the number ==
O -> C : press "Change phone number", type the\n"New phone number (10 digits)", press "Save number"
C -> S : move the customer and every entry to the new number
note right of S : entries follow the customer's number,\nso all of them move with it
C --> O : "Phone number changed."
== Delete, with Undo ==
O -> C : press "Delete customer", then\n"Press again to delete {name} and all their entries"
C -> S : remove the customer and their entries
C --> O : "Deleted {name}." with "Undo"
opt the owner changes their mind
  O -> C : tap "Undo"
  C -> S : put the customer and the entries back
  C --> O : "Restored {name}."
end
== Correct the spelling ==
O -> H : under "Customer details" change "Name", "Name in Hindi"\nor "Name in Telugu", press "Save details"
H -> S : save the details
H --> O : "Customer details saved."
@enduml
