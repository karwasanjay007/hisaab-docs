@startuml c4-container
!include <C4/C4_Container>
title Hisaab: containers (C4 level 2)

Person(owner, "Shop owner", "Uses Hisaab in a phone or desktop browser")
System_Ext(whatsapp, "WhatsApp", "Chat opened from a wa.me link")
System_Ext(upi, "UPI app", "Opens upi://pay links")
System_Ext(dialer, "Phone dialer", "Opens tel: links")
System_Ext(cdn, "cdnjs and jsDelivr", "Public script CDNs")
System_Ext(vercel, "Vercel static hosting", "Serves the site over HTTPS")

System_Boundary(browser, "Owner's browser") {
  Container(spa, "Single-page app", "HTML, CSS, vanilla JavaScript", "index.html, styles.css, sample.js and app.js; hash routes, one IIFE, no framework, no build step")
  Container(addons, "Add-ons", "profile.js + profile.css, shops.js + shops.css", "v1.1: loaded after app.js. profile.js: shop profile (owner, address, logo) in Shop settings, the header and the printed statement, and a balance history line as inline SVG on the customer page. shops.js: several shops on one phone (add, switch, remove, Import as a new shop)")
  ContainerDb(ls, "localStorage", "Web Storage, JSON", "hisaab.v1 holds the whole current shop; hisaab.lang and hisaab.theme hold preferences; v1.1: hisaab.shops parks the other shops, written only once a second shop exists; v1.2: no new key, hisaab.lang can now hold one of twelve language codes")
  Container(sw, "Service worker and cache", "sw.js, Cache API", "Precaches the app shell in cache hisaab-v4 (v1.1: also profile.css, profile.js, shops.css, shops.js; v1.2: also extras.css, extras.js, customer.css, customer.js, langs.js); v1.2: the i18n files are not precached, each is cached the first time it is fetched; network first for the app's files, the QR library and Google Fonts; the cached copy offline")
  Container(addons12, "Add-ons 1.2", "langs.js, extras.js + extras.css, customer.js + customer.css", "v1.2: loaded after app.js. langs.js: nine more languages (Bengali, Marathi, Tamil, Gujarati, Kannada, Malayalam, Punjabi, Odia, Urdu); English, Hindi and Telugu stay built into app.js. extras.js: note shortcut buttons under the note field, and a one-line total of what is unpaid for 30 days or more above the overdue list. customer.js: on the customer page, total given and total received, days since the last payment, Call and WhatsApp chat links, change phone number, delete customer with Undo")
  Container(i18nfiles, "Language files", "i18n folder, one JSON file per language code", "v1.2: i18n/*.json; sections core, profile, shops, customer, extras; 216 text keys each; fetched only when that language is chosen, then kept for use without signal")
  Container(libs, "Lazy-loaded libraries", "qrcode-generator 1.4.4, Tesseract.js 5.1.1", "Script tags added only when a QR code, a statement or a screenshot needs them")
  Container(speech, "Web Speech API", "SpeechRecognition, built into the browser", "Turns spoken quick entry into text in en-IN, hi-IN or te-IN")
}

Rel(owner, spa, "Taps, types and speaks")
Rel(spa, ls, "Reads on start, writes after every change", "getItem, setItem")
Rel(addons, spa, "v1.1: listens to render, statement, imported and export; reads and replaces the shop", "window.Hisaab: on, state, replace, save, render")
Rel(addons, ls, "v1.1: shops.js parks and restores the other shops", "hisaab.shops")
Rel(addons12, spa, "v1.2: adds languages, reads balances and overdue rows, teaches quick entry each language's words for gave and got", "window.Hisaab: addLanguage, hasLanguage, setLang, text, balances, overdue, quickWords")
Rel(addons12, i18nfiles, "v1.2: langs.js fetches the file of the chosen language", "fetch")
Rel(sw, i18nfiles, "v1.2: caches each file the first time it is fetched", "Cache API")
Rel(spa, sw, "Registers on HTTPS or localhost", "serviceWorker.register")
Rel(sw, vercel, "Fetches the latest files first", "HTTPS")
Rel(spa, libs, "Calls qrcode() and Tesseract.recognize()")
Rel(libs, cdn, "Downloaded from", "HTTPS")
Rel(spa, speech, "Starts listening when the microphone is tapped")
Rel(spa, whatsapp, "Opens reminder, receipt and remind-all links", "wa.me")
Rel(spa, upi, "Pay link inside the reminder and the QR code", "upi://pay")
Rel(addons12, whatsapp, "v1.2: customer.js opens a plain chat", "wa.me")
Rel(addons12, dialer, "v1.2: customer.js Call link", "tel:+91")

LAYOUT_WITH_LEGEND()
@enduml
