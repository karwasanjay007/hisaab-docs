@startuml c4-container
!include <C4/C4_Container>
title Hisaab: containers (C4 level 2)

Person(owner, "Shop owner", "Uses Hisaab in a phone or desktop browser")
System_Ext(hosting, "Static hosting", "Serves the site over HTTPS at hisaab-hazel.vercel.app; no functions, no server code")
System_Ext(whatsapp, "WhatsApp", "Chat opened from a wa.me link")
System_Ext(upi, "UPI app", "Opens upi://pay links")
System_Ext(dialer, "Phone dialer", "Opens tel: links")
System_Ext(sms, "SMS app", "Opens sms: links")
System_Ext(cdn, "jsDelivr", "Public script CDN: the screenshot reader, Tesseract.js 5.1.1")
System_Ext(speech, "Browser's speech service", "SpeechRecognition; the browser sends the audio to its maker")

System_Boundary(browser, "Owner's browser") {
  Container(spa, "Ledger page", "index.html, app.js, sample.js, styles.css", "The one page and the ledger: state, balances, overdue, routes, quick entry, voice, screenshot, import, export, statement, theme; English, Hindi and Telugu text; no framework, no build step")
  Container(addons, "Add-on scripts", "profile.js, shops.js, langs.js, extras.js, customer.js, names.js, sendways.js, wacheck.js, assist.js, guard.js, compact.js", "Loaded after app.js in that order. Each one starts only if window.Hisaab exists and adds its part to the page after every draw")
  Container(sheets, "Style sheets and fonts", "profile.css, shops.css, extras.css, customer.css, polish.css, brand.css, compact.css, guard.css, fonts/", "Add-on styles, layout fixes, brand colours, the compact chat layout, and 16 font files served by the site")
  Container(i18nfiles, "Language files", "i18n/, 12 JSON files", "One file per language, 256 text keys each; a file is fetched only when one of the nine newer languages is chosen")
  Container(paypage, "Pay page", "pay.html", "A separate small page a reminder links to. Reads shop, UPI ID and amount from the part after #, which a browser does not send to a server, and opens the upi://pay link")
  Container(qrlib, "QR library", "vendor/qrcode.min.js", "Served by the site; loaded when a QR code or a statement is first drawn")
  Container(sw, "Service worker", "sw.js, Cache API", "Network first, the cache hisaab-v22 as the fallback; precaches 47 files of the site")
  ContainerDb(ls, "localStorage", "Web Storage, JSON", "Everything the shop records: hisaab.v1 (the open shop), hisaab.shops (the other shops), hisaab.wa (WhatsApp check answers), hisaab.lang, hisaab.theme, hisaab.guard (a test write, removed at once)")
  ContainerDb(cache, "Cache hisaab-v22", "Cache API", "Copies of the site's own files; no ledger data")
}

Rel(owner, spa, "Taps, types and speaks")
Rel(hosting, spa, "Serves every file of the site", "HTTPS")
Rel(spa, ls, "Reads on start, writes after every change", "getItem, setItem")
Rel(addons, spa, "Listen to render, statement, imported and export; read and replace the shop", "window.Hisaab")
Rel(addons, ls, "shops.js parks the other shops; wacheck.js keeps the answers; guard.js tests that storage works", "hisaab.shops, hisaab.wa, hisaab.guard")
Rel(addons, i18nfiles, "langs.js fetches the file of the chosen language", "fetch")
Rel(spa, qrlib, "Calls qrcode() for the QR code and the statement")
Rel(spa, sw, "Registers on HTTPS or localhost", "serviceWorker.register")
Rel(sw, cache, "Stores every good answer from the site; reads when the network fails")
Rel(sw, hosting, "Asks the network first", "HTTPS")
Rel(spa, cdn, "Fetches the screenshot reader when a screenshot is chosen", "HTTPS")
Rel(spa, speech, "Starts listening when the microphone button is pressed", "SpeechRecognition")
Rel(spa, whatsapp, "Reminder, receipt and remind-all links the owner taps", "wa.me")
Rel(addons, whatsapp, "Plain chat, hello message, choose a contact", "wa.me")
Rel(addons, sms, "sendways.js: the reminder as an SMS", "sms:")
Rel(addons, dialer, "customer.js: Call", "tel:+91")
Rel(spa, paypage, "The reminder carries an https link to it", "pay.html#pn=...&pa=...&am=...")
Rel(spa, upi, "Pay link and QR code", "upi://pay")
Rel(paypage, upi, "Opens the pay link", "upi://pay")

LAYOUT_WITH_LEGEND()
@enduml
