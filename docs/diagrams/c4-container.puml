@startuml c4-container
!include <C4/C4_Container>
title Hisaab: containers (C4 level 2)

Person(owner, "Shop owner", "Uses Hisaab in a phone or desktop browser")
System_Ext(whatsapp, "WhatsApp", "Chat opened from a wa.me link")
System_Ext(upi, "UPI app", "Opens upi://pay links")
System_Ext(cdn, "cdnjs and jsDelivr", "Public script CDNs")
System_Ext(vercel, "Vercel static hosting", "Serves the site over HTTPS")

System_Boundary(browser, "Owner's browser") {
  Container(spa, "Single-page app", "HTML, CSS, vanilla JavaScript", "index.html, styles.css, sample.js and app.js; hash routes, one IIFE, no framework, no build step")
  ContainerDb(ls, "localStorage", "Web Storage, JSON", "hisaab.v1 holds the whole shop; hisaab.lang and hisaab.theme hold preferences")
  Container(sw, "Service worker and cache", "sw.js, Cache API", "Precaches the app shell in cache hisaab-v2; network first for the app's files, the QR library and Google Fonts; the cached copy offline")
  Container(libs, "Lazy-loaded libraries", "qrcode-generator 1.4.4, Tesseract.js 5.1.1", "Script tags added only when a QR code, a statement or a screenshot needs them")
  Container(speech, "Web Speech API", "SpeechRecognition, built into the browser", "Turns spoken quick entry into text in en-IN, hi-IN or te-IN")
}

Rel(owner, spa, "Taps, types and speaks")
Rel(spa, ls, "Reads on start, writes after every change", "getItem, setItem")
Rel(spa, sw, "Registers on HTTPS or localhost", "serviceWorker.register")
Rel(sw, vercel, "Fetches the latest files first", "HTTPS")
Rel(spa, libs, "Calls qrcode() and Tesseract.recognize()")
Rel(libs, cdn, "Downloaded from", "HTTPS")
Rel(spa, speech, "Starts listening when the microphone is tapped")
Rel(spa, whatsapp, "Opens reminder, receipt and remind-all links", "wa.me")
Rel(spa, upi, "Pay link inside the reminder and the QR code", "upi://pay")

LAYOUT_WITH_LEGEND()
@enduml
