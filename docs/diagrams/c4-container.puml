@startuml c4-container
!include <C4/C4_Container>
title Hisaab 2.0.1.0: containers (C4 level 2)

Person(owner, "Shop owner", "Uses Hisaab in a phone or desktop browser")
System_Ext(whatsapp, "WhatsApp", "Chat opened from a wa.me link")
System_Ext(upi, "UPI app", "Opens the upi://pay address in the reminder text")
System_Ext(host, "Static hosting", "Serves the built site over HTTPS; every address is answered with index.html")

System_Boundary(browser, "Owner's browser") {
  Container(page, "React page", "React 19, TypeScript, Tailwind CSS 4, built by Vite 6", "index.html, main.tsx and App.tsx with the components CustomerRow and ImportBox. Four views held in component state: home, customer, overdue, settings. Fonts are bundled with the build")
  Container(store, "Shop store", "Zustand 5 with the persist middleware", "useShopStore: shop name, customers, entries, shop UPI id, and the actions that change them. Every change goes through commit(), which puts the ledger back if the browser's store refuses the write")
  Container(lib, "Library modules", "TypeScript, no framework", "lib/ledger (the one place for sums, dates, ids and the reminder link), lib/validate (import), lib/images (screenshot resize), lib/csv (two exports and the overdue list), lib/legacy (carry-over from version 1), i18n/translations (English, Hindi, Telugu)")
  ContainerDb(ls, "localStorage", "Web Storage, JSON", "hisaab-shop-v2 holds the ledger; hisaab-lang and hisaab-theme hold the two preferences. The version 1 keys hisaab.v1, hisaab.lang and hisaab.theme are read once and left in place")
  Container(sw, "Service worker and cache", "public/sw.js, Cache API", "Cache hisaab-v20. Network first for same-origin GET requests, the stored copy when there is no signal. Deletes every other cache, which removes the version 1 caches")
}

Rel(owner, page, "Taps and types")
Rel(page, store, "Reads state, calls actions", "useShopStore hook")
Rel(page, lib, "Computes balances, totals, CSV text, the resized picture and the reminder link")
Rel(store, lib, "Validates an import, makes ids, converts a version 1 ledger")
Rel(store, ls, "Reads on start, writes after every change", "getItem, setItem")
Rel(page, ls, "Reads and writes language and theme", "useLang, useTheme")
Rel(page, sw, "Registers it in a built site and sends the addresses already loaded", "register, postMessage")
Rel(sw, host, "Fetches the site's files, network first", "HTTPS")
Rel(page, whatsapp, "Remind link opens a chat with the text filled in", "https://wa.me/91<phone>?text=")
Rel(whatsapp, upi, "The customer uses the pay address in the message", "upi://pay")

SHOW_LEGEND()
@enduml
