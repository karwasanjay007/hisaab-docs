@startuml j9-language-offline
title J9 Language, theme and opening with no signal
skinparam backgroundColor white
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 13
skinparam roundCorner 12
skinparam shadowing false
skinparam maxMessageSize 280
skinparam titleFontSize 17
skinparam titleFontColor #0E5C45
skinparam sequenceMessageAlign left
skinparam sequence {
  ArrowColor #0E5C45
  LifeLineBorderColor #7FA89A
  ParticipantBorderColor #0E5C45
  ParticipantBackgroundColor #E8F2EE
  ActorBorderColor #0E5C45
  ActorBackgroundColor #E8F2EE
  GroupBorderColor #0E5C45
  GroupBackgroundColor #F3F8F6
  DividerBorderColor #0E5C45
  DividerBackgroundColor #E8F2EE
}
skinparam database {
  BorderColor #0E5C45
  BackgroundColor #E8F2EE
}
skinparam note {
  BorderColor #B08A2E
  BackgroundColor #FFF8E6
  FontSize 12
}
actor "Shop owner" as Owner
participant "React page\n(App.tsx)" as UI
participant "useLang, useTheme" as Hooks
participant "i18n/translations" as I18n
database "localStorage" as LS
participant "Service worker\n(sw.js)" as SW
participant "Static hosting" as Host

== Language ==
Owner -> UI : picks English, Hindi or Telugu in the header list
UI -> Hooks : setLang(code)
Hooks -> LS : setItem("hisaab-lang", code)
Hooks -> UI : sets the page's lang attribute
UI -> I18n : t(key): the chosen language, else English, else the key
UI --> Owner : labels, messages and the reminder text in that language

== Theme ==
Owner -> UI : presses the light or dark button
UI -> Hooks : toggle()
Hooks -> LS : setItem("hisaab-theme", "light" or "dark")
UI --> Owner : colours change; the status line says which theme is on

== Online: every request ==
UI -> SW : same-origin GET
SW -> Host : fetch (network first)
Host --> SW : response
SW -> SW : a good response is copied into cache hisaab-v20
SW --> UI : the fresh response

== No signal ==
Owner -> UI : opens the address
UI -> SW : navigation request
SW -> Host : fetch fails
SW -> SW : caches.match by address (query ignored for a page);\na page with no stored copy gets the stored "/"
SW --> UI : the stored page, script, style and fonts
UI -> LS : reads hisaab-shop-v2, hisaab-lang, hisaab-theme
UI --> Owner : the same ledger, language and theme; every change still saves
@enduml
