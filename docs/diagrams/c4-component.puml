@startuml c4-component
!include <C4/C4_Component>
title Hisaab: components inside app.js (C4 level 3)

skinparam wrapWidth 115
skinparam maxMessageSize 60

Container_Boundary(app, "app.js") {
  Component(init, "Start", "init", "Loads the state or starts an empty shop, binds the listeners")
  Component(router, "Routes", "route, goTo", "#/, #/s/<section>, #/c/<phone>; navigation, bottom bar, More sheet")
  Component(theme, "Theme", "toggleTheme", "Light and dark, following the device until chosen")

  Component(render, "Drawing", "render, runningBalances", "Builds the home view, the lists and the customer page")
  Component(form, "Entry and customer forms", "onEntrySubmit, startEdit, deleteEntry, onAddCustomer, toast", "Adds, edits and deletes; Undo in the toast")
  Component(quick, "Quick entry and voice", "parseQuick, applyQuick, setupVoice", "Reads a typed or spoken sentence and fills the form")
  Component(shot, "Screenshot", "onShotChange, loadTesseract, readAmount, pickAmount", "Shrinks the picture and reads the paid amount")

  Component(store, "State and ledger", "load, save, fromShopFile, balances, totalOutstanding, overdueRows", "The shop object, its checks and every worked-out figure")
  Component(i18n, "Text and names", "t, translit, localName, money, digits, niceDate", "English, Hindi and Telugu text, names in local script, rupee and date formats")
  Component(remind, "Reminders and pay links", "reminderText, payPage, waLink, upiLink, receiptLink, renderRemindAll", "WhatsApp links with name, balance and pay links; the remind-all queue")
  Component(io, "Import and export", "doImport, fromCsv, exportEntries, exportBalances, exportJson", "Replaces the shop from JSON or CSV with Undo; two CSV files and a backup file")

  Component(stmt, "Statement", "printStatement", "Printable statement with totals and a scan-to-pay QR")
  Component(qr, "QR", "showQr", "UPI QR code on the customer page, drawn as SVG")
  Component(hook, "Add-on hook", "window.Hisaab", "on(name, fn) for render, statement, imported, export; state, replace, save, text, addLanguage, quickWords, the frozen ledger object")
}

ContainerDb(ls, "localStorage", "Web Storage", "hisaab.v1, hisaab.lang, hisaab.theme")
Container_Ext(addons, "Add-on scripts", "eleven files, see the add-ons diagram", "Each listens through window.Hisaab; names.js sets nameIn")
Container_Ext(qrlib, "QR library", "vendor/qrcode.min.js", "Loaded when a QR code is first drawn")
Container_Ext(reader, "Screenshot reader", "Tesseract.js 5.1.1 from jsDelivr", "Fetched only when a screenshot is chosen")
Container_Ext(speechapi, "Browser's speech service", "SpeechRecognition", "Built into the browser; needs the internet")
Container_Ext(swc, "Service worker", "sw.js", "Network first, the cache hisaab-v23 as the fallback")

Lay_R(init, router)
Lay_R(router, theme)
Lay_D(init, render)
Lay_R(render, form)
Lay_R(form, quick)
Lay_D(render, store)
Lay_R(store, i18n)
Lay_R(i18n, shot)
Lay_D(store, remind)
Lay_R(remind, io)
Lay_R(io, hook)
Lay_D(remind, stmt)
Lay_R(stmt, qr)
Lay_D(stmt, ls)
Lay_R(ls, addons)
Lay_R(addons, swc)
Lay_D(ls, qrlib)
Lay_R(qrlib, reader)
Lay_R(reader, speechapi)

Rel_D(init, store, "load()")
Rel_R(init, router, "route()")
Rel_D(init, swc, "Registers sw.js")
Rel_D(router, render, "render() for the chosen view")
Rel_D(render, store, "Reads balances and entries")
Rel_D(render, i18n, "Labels, names, money")
Rel_D(render, remind, "Reminder links on rows")
Rel_D(form, store, "Changes entries, save()")
Rel_L(form, render, "Draws again")
Rel_D(form, remind, "Receipt link in the toast")
Rel_L(quick, form, "Fills the form")
Rel_D(quick, speechapi, "Listens")
Rel_U(shot, form, "Sets payment, picture and amount")
Rel_D(shot, reader, "Loads and calls the reader", "HTTPS")
Rel_U(io, store, "fromShopFile(), save()")
Rel_R(stmt, qr, "Embeds the QR code")
Rel_U(qr, remind, "Encodes upiLink()")
Rel_D(qr, qrlib, "qrcode()")
Rel_D(store, ls, "hisaab.v1", "JSON")
Rel_D(theme, ls, "hisaab.theme")
Rel_D(i18n, ls, "hisaab.lang")
Rel_D(render, hook, "Emits render")
Rel_U(stmt, hook, "Emits statement")
Rel_R(io, hook, "Emits imported and export")
Rel_U(hook, store, "state(), replace(next), save")
Rel_U(hook, i18n, "addLanguage, setLang, text")
Rel_U(hook, quick, "quickWords")
Rel_U(addons, hook, "on(name, fn); read and change the shop")
Rel_D(i18n, addons, "Asks nameIn for a name in a newer script")

SHOW_LEGEND()
@enduml
