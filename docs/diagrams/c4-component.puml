@startuml c4-component
!include <C4/C4_Component>
title Hisaab: components inside app.js (C4 level 3)

ContainerDb(ls, "localStorage", "Web Storage", "hisaab.v1, hisaab.lang, hisaab.theme; v1.1: hisaab.shops; v1.2: no new key, hisaab.lang holds one of twelve codes; v1.2.3: hisaab.wa")
Container_Ext(cdnlibs, "Lazy libraries", "qrcode-generator, Tesseract.js", "Loaded from CDNs on demand")
Container_Ext(speechapi, "Web Speech API", "Built into the browser", "SpeechRecognition")
Container_Ext(swc, "Service worker", "sw.js", "Offline fallback; v1.1: the app shell also lists profile.css, profile.js, shops.css, shops.js; v1.2: cache hisaab-v4, the app shell also lists extras.css, extras.js, customer.css, customer.js, langs.js; v1.2.3: cache hisaab-v8 (v1.2.4: hisaab-v9; v1.2.5: hisaab-v10, also assist.js), also names.js, sendways.js, wacheck.js, polish.css, pay.html; the i18n files are cached the first time each is fetched")
Container_Ext(profile, "Shop profile add-on", "profile.js, profile.css", "v1.1: owner, address and logo in Shop settings, the header and the printed statement; balance history line as inline SVG on the customer page")
Container_Ext(shops, "Several shops add-on", "shops.js, shops.css", "v1.1: add, switch and remove shops, Import as a new shop; the current shop stays under hisaab.v1")

Container_Ext(langs, "More languages add-on", "langs.js", "v1.2: nine more languages (Bengali, Marathi, Tamil, Gujarati, Kannada, Malayalam, Punjabi, Odia, Urdu); fetches a language file only when that language is chosen")
Container_Ext(i18nfiles, "Language files", "i18n/*.json", "v1.2: one file per language code; sections core, profile, shops, customer, extras; 216 text keys each at v1.2.0, 233 at v1.2.3, 235 at v1.2.4; not precached")
Container_Ext(extras, "Extras add-on", "extras.js, extras.css", "v1.2: note shortcut buttons under the note field; a one-line total of what is unpaid for 30 days or more above the overdue list")
Container_Ext(customer, "Customer page add-on", "customer.js, customer.css", "v1.2: total given and total received, days since the last payment, Call and WhatsApp chat links, change phone number, delete customer with Undo")

Container_Ext(names, "Names add-on", "names.js", "v1.2.1: customer names in nine more scripts, built from the Devanagari spelling; registers nameIn")
Container_Ext(sendways, "Send ways add-on", "sendways.js", "v1.2.2: the reminder as SMS, to a contact chosen in WhatsApp, or copied")
Container_Ext(wacheck, "WhatsApp check add-on", "wacheck.js", "v1.2.3: hello message after a customer is added; stores the owner's answer in hisaab.wa")
Container_Ext(assist, "Assist add-on", "assist.js", "v1.2.5: says which theme is on and which view is showing; the skip link; quick entry offers to add a customer it does not know. Stores nothing")

Container_Boundary(app, "app.js (one IIFE)") {
  Component(init, "Wire-up", "init()", "Loads state or starts an empty shop, binds every listener, registers the service worker")
  Component(store, "State and storage", "load, save, fromShopFile, balances, totalOutstanding, overdueRows", "The shop object, its validation and every computed figure")
  Component(i18n, "i18n", "I18N, t, applyLabels, translit, money, digits", "English, Hindi and Telugu labels, names in local script, rupee formatting; v1.2: more languages arrive through addLanguage")
  Component(render, "Rendering", "render, renderCustomer, entryHtml, runningBalances", "Builds the overview, lists and customer page from state, escaping text")
  Component(router, "Routing and navigation", "route, goTo, spy, closeSheet", "Hash routes #/, #/s/section, #/c/phone; left nav, bottom bar, More sheet")
  Component(form, "Entry form and validation", "onEntrySubmit, startEdit, deleteEntry, onAddCustomer, toast", "Adds, edits and deletes entries and customers; Undo through the toast")
  Component(quick, "Quick entry and voice", "parseQuick, applyQuick, onQuick, setupVoice", "Parses Sunita 500 udhaar, typed or spoken, and fills the form; v1.2: quickWords adds each language's words for gave and got; v1.2.4: every voice failure is said, with a keyboard or dictation tip")
  Component(remind, "Reminders", "reminderText, payPage, waLink, upiLink, receiptLink, renderRemindAll", "WhatsApp links with name, balance and UPI pay link; remind-all queue; v1.2.1: payPage adds an https link to pay.html")
  Component(qr, "QR", "loadQr, qrSvg, showQr", "UPI QR code on the customer page")
  Component(stmt, "Statement", "printStatement", "Printable customer statement with totals and a scan-to-pay QR")
  Component(io, "Import and export", "doImport, fromCsv, csvRows, exportEntries, exportBalances, exportJson, csvCell", "Replaces the shop from JSON or CSV with Undo; writes CSV and JSON files")
  Component(shot, "Screenshot reading", "onShotChange, loadTesseract, readAmount, pickAmount", "Resizes to a 640 px JPEG and reads the paid amount")
  Component(theme, "Theme", "currentTheme, toggleTheme", "Light and dark, following the system until chosen")
  Component(hook, "Add-on hook", "window.Hisaab: on(event, fn), state(), replace(shop), save(), render()", "v1.1: emits render, statement, imported and export to the add-ons; each listener runs in its own guard; v1.2: also addLanguage, hasLanguage, setLang, text, balances, overdue, quickWords and a few read-only helpers; v1.2.1: translit, and the slot nameIn that names.js fills")
}

Rel(init, store, "load(); an empty shop on first visit")
Rel(init, router, "route() on start and on hashchange")
Rel(init, swc, "Registers sw.js")
Rel(store, ls, "Reads and writes", "JSON")
Rel(router, render, "render() for the chosen view")
Rel(render, store, "Reads balances and entries")
Rel(render, i18n, "Labels, names, money")
Rel(render, remind, "Reminder hrefs on rows")
Rel(form, store, "Changes entries, save()")
Rel(form, render, "Re-renders after a change")
Rel(form, remind, "Receipt link in the toast")
Rel(quick, form, "Fills the entry form; the owner presses Save")
Rel(quick, speechapi, "Listens", "SpeechRecognition")
Rel(shot, form, "Sets payment type, picture and amount")
Rel(shot, cdnlibs, "Tesseract.recognize()")
Rel(io, store, "fromShopFile(), save()")
Rel(qr, cdnlibs, "qrcode()")
Rel(qr, remind, "Encodes upiLink()")
Rel(stmt, qr, "Embeds the QR code")
Rel(theme, ls, "hisaab.theme")
Rel(i18n, ls, "hisaab.lang")
Rel(render, hook, "Emits render")
Rel(stmt, hook, "Emits statement")
Rel(io, hook, "Emits imported and export")
Rel(hook, store, "state(), replace(shop), save()")
Rel(profile, hook, "Listens and reads the shop", "window.Hisaab")
Rel(shops, hook, "Listens, replaces the shop", "window.Hisaab")
Rel(shops, ls, "Parks the other shops", "hisaab.shops")

Rel(langs, hook, "v1.2: adds a language and its quick entry words", "addLanguage, hasLanguage, setLang, quickWords")
Rel(langs, i18nfiles, "v1.2: fetches the chosen language", "fetch")
Rel(swc, i18nfiles, "v1.2: caches on first fetch", "Cache API")
Rel(extras, hook, "v1.2: listens to render, reads overdue rows and labels", "overdue, text")
Rel(customer, hook, "v1.2: listens to render, reads balances, changes the shop", "balances, text, replace, save")
Rel(hook, i18n, "v1.2: addLanguage, setLang, text")
Rel(hook, quick, "v1.2: quickWords")
Rel(names, hook, "v1.2.1: registers nameIn, uses translit", "nameIn, translit")
Rel(i18n, hook, "v1.2.1: asks nameIn for a name in a newer script")
Rel(sendways, hook, "v1.2.2: listens to render, reads the reminder", "window.Hisaab")
Rel(wacheck, hook, "v1.2.3: hears a customer added by hand", "window.Hisaab")
Rel(assist, hook, "v1.2.5: reads the language, the text and the quick-entry parse", "window.Hisaab")
Rel(wacheck, ls, "v1.2.3: the owner's answer", "hisaab.wa")

LAYOUT_WITH_LEGEND()
@enduml
