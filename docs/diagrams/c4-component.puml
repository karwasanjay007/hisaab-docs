@startuml c4-component
!include <C4/C4_Component>
title Hisaab: components inside app.js and the add-ons around it (C4 level 3)

ContainerDb(ls, "localStorage", "Web Storage", "hisaab.v1, hisaab.shops, hisaab.wa, hisaab.lang, hisaab.theme, hisaab.guard")
Container_Ext(qrlib, "QR library", "vendor/qrcode.min.js", "Served by the site, loaded when a QR code is first drawn")
Container_Ext(reader, "Screenshot reader", "Tesseract.js 5.1.1 from jsDelivr", "Fetched only when a screenshot is chosen; reads the picture in the browser")
Container_Ext(speechapi, "Browser's speech service", "SpeechRecognition", "Built into the browser; needs the internet")
Container_Ext(swc, "Service worker", "sw.js", "Network first, the cache hisaab-v22 as the fallback")
Container_Ext(i18nfiles, "Language files", "i18n/*.json", "One file per language; groups core, profile, shops, customer, extras, compact; 256 text keys")

Container_Ext(profile, "Shop profile", "profile.js, profile.css", "Owner, address and logo in Shop settings, the top bar and the statement; Balance over time on the customer page")
Container_Ext(shops, "Several shops", "shops.js, shops.css", "Add, switch and remove shops; Import as a new shop")
Container_Ext(langs, "More languages", "langs.js", "Nine more languages, each fetched when chosen")
Container_Ext(extras, "Extras", "extras.js, extras.css", "Note shortcuts, the overdue total line, the date the figures are for")
Container_Ext(customer, "Customer tools", "customer.js, customer.css", "Totals, Call, WhatsApp chat, change phone number, delete customer with Undo")
Container_Ext(names, "Names", "names.js", "A customer's name in the script of the nine newer languages; sets nameIn")
Container_Ext(sendways, "Other ways to send", "sendways.js", "The reminder as SMS, to a chosen contact, or copied; demo UPI notice")
Container_Ext(wacheck, "WhatsApp check", "wacheck.js", "Hello message and the owner's answer per number")
Container_Ext(assist, "Assist", "assist.js", "Says which theme and which view; skip link; offers to add an unknown name")
Container_Ext(guard, "Guard", "guard.js, guard.css", "Storage full or blocked notices, imported picture limit, whole rupees")
Container_Ext(compact, "Compact layout", "compact.js, compact.css", "Quick entry pill, the + menu, summary strip, right panel, right to left for Urdu")

Container_Boundary(app, "app.js") {
  Component(init, "Start", "init", "Loads the state or starts an empty shop, binds every listener, registers the service worker")
  Component(store, "State and ledger", "load, save, fromShopFile, balances, totalOutstanding, overdueRows", "The shop object, its checks and every worked-out figure")
  Component(i18n, "Text and names", "t, translit, localName, money, digits, niceDate", "English, Hindi and Telugu text, names in local script, rupee and date formats")
  Component(render, "Drawing", "render, runningBalances", "Builds the home view, the lists and the customer page from the state")
  Component(router, "Routes", "route, goTo", "#/, #/s/<section>, #/c/<phone>; left navigation, bottom bar, More sheet")
  Component(form, "Entry and customer forms", "onEntrySubmit, startEdit, deleteEntry, onAddCustomer, toast", "Adds, edits and deletes; Undo in the toast")
  Component(quick, "Quick entry and voice", "parseQuick, applyQuick, setupVoice", "Reads a sentence such as Sunita 500 udhaar, typed or spoken, and fills the form")
  Component(remind, "Reminders and pay links", "reminderText, payPage, waLink, upiLink, receiptLink, renderRemindAll", "WhatsApp links with name, balance and pay links; the remind-all queue")
  Component(qr, "QR", "showQr", "UPI QR code on the customer page, drawn as SVG")
  Component(stmt, "Statement", "printStatement", "Printable statement with totals and a scan-to-pay QR")
  Component(io, "Import and export", "doImport, fromCsv, exportEntries, exportBalances, exportJson", "Replaces the shop from JSON or CSV with Undo; writes two CSV files and a backup file")
  Component(shot, "Screenshot", "onShotChange, loadTesseract, readAmount, pickAmount", "Shrinks the picture to a 600 px JPEG and reads the paid amount")
  Component(theme, "Theme", "toggleTheme", "Light and dark, following the device until chosen")
  Component(hook, "Add-on hook", "window.Hisaab", "on(name, fn) for render, statement, imported, export; state, replace, save, text, addLanguage, quickWords, the frozen ledger object")
}

Rel(init, store, "load(); an empty shop on a first visit")
Rel(init, router, "route() on start and on hashchange")
Rel(init, swc, "Registers sw.js")
Rel(store, ls, "Reads and writes hisaab.v1", "JSON")
Rel(router, render, "render() for the chosen view")
Rel(render, store, "Reads balances and entries")
Rel(render, i18n, "Labels, names, money")
Rel(render, remind, "Reminder links on rows")
Rel(form, store, "Changes entries, save()")
Rel(form, render, "Draws again after a change")
Rel(form, remind, "Receipt link in the toast")
Rel(quick, form, "Fills the entry form; the owner presses Save entry")
Rel(quick, speechapi, "Listens", "SpeechRecognition")
Rel(shot, form, "Sets payment, picture and amount")
Rel(shot, reader, "Loads and calls the reader", "HTTPS")
Rel(io, store, "fromShopFile(), save()")
Rel(qr, qrlib, "qrcode()")
Rel(qr, remind, "Encodes upiLink()")
Rel(stmt, qr, "Embeds the QR code")
Rel(theme, ls, "hisaab.theme")
Rel(i18n, ls, "hisaab.lang")
Rel(render, hook, "Emits render")
Rel(stmt, hook, "Emits statement")
Rel(io, hook, "Emits imported and export")
Rel(hook, store, "state(), replace(next), save")
Rel(hook, i18n, "addLanguage, setLang, text")
Rel(hook, quick, "quickWords")
Rel(i18n, names, "Asks nameIn for a name in a newer script")

Rel(profile, hook, "render, statement, imported, export")
Rel(shops, hook, "render, imported; replaces the shop")
Rel(shops, ls, "Parks the other shops", "hisaab.shops")
Rel(langs, hook, "Adds a language and its quick entry words")
Rel(langs, i18nfiles, "Fetches the chosen language", "fetch")
Rel(swc, i18nfiles, "Caches each file the first time it is fetched", "Cache API")
Rel(extras, hook, "render; reads overdue rows")
Rel(customer, hook, "render; reads balances, changes the shop")
Rel(names, hook, "Sets nameIn, uses translit")
Rel(sendways, hook, "render; reads the reminder on the page")
Rel(wacheck, hook, "render, imported")
Rel(wacheck, ls, "The owner's answer", "hisaab.wa")
Rel(assist, hook, "Reads the language, the text and the quick entry result")
Rel(guard, hook, "render, imported; watches writes to hisaab.v1")
Rel(guard, ls, "Tests that storage works", "hisaab.guard")
Rel(compact, hook, "render; moves the quick entry form and the lists")

LAYOUT_WITH_LEGEND()
@enduml
