@startuml c4-component
!include <C4/C4_Component>
title Hisaab 2.0.1.0: components of the page (C4 level 3)

ContainerDb(ls, "localStorage", "Web Storage", "hisaab-shop-v2, hisaab-lang, hisaab-theme; version 1 keys read once")
Container(sw, "Service worker", "public/sw.js", "Cache hisaab-v20, network first")
System_Ext(whatsapp, "WhatsApp", "wa.me link")

Container_Boundary(app, "React page (src/)") {
  Component(main, "main.tsx", "Entry", "Loads the bundled fonts, renders App, registers /sw.js in a built site and posts the list of loaded addresses to it")
  Component(appc, "App.tsx", "React component", "Header (theme button, language list), status line with Undo, total outstanding, the four views (home, customer, overdue, settings), the entry and customer forms, bottom navigation, CSV download")
  Component(row, "components/CustomerRow", "React component", "One customer: name, phone, balance and the Remind link")
  Component(imp, "components/ImportBox", "React component", "Text box #import-box and button #import-go; shows the import error")
  Component(uselang, "hooks/useLang", "React hook", "Current language, t(key, vars) with English as the fallback, sets the page's lang attribute")
  Component(usetheme, "hooks/useTheme", "React hook", "Light or dark; follows the system until the owner chooses")
  Component(i18n, "i18n/translations", "TypeScript table", "Text keys in English, Hindi and Telugu")
  Component(store, "store/useShopStore", "Zustand store with persist", "State: shop, customers, entries, shopUpi, importError, statusMessage, lastDeleted. Actions: importJson, addCustomer, addEntry, updateEntry, deleteEntry, undoDelete, setShopUpi. commit() rolls back a refused write")
  Component(ledger, "lib/ledger", "Pure functions", "signedAmount, balanceOf, totalOutstanding, entriesNewestFirst, daysSinceLastPayment, customersByHighestBalance, formatRs, todayFromUrl, reminderHref, newId, importIds")
  Component(validate, "lib/validate", "Pure functions", "validateImport: checks a pasted shop file and returns clean data or the first error")
  Component(images, "lib/images", "Canvas", "resizeToDataUrl: fits a picture inside 600 px and under 150,000 characters as JPEG")
  Component(csv, "lib/csv", "Pure functions", "balancesCsv, entriesCsv, overdueList")
  Component(legacy, "lib/legacy", "Pure functions", "legacyToV2 converts a version 1 ledger; readKey and writeKey guard storage that may be blocked")
  Component(types, "lib/types", "TypeScript types", "Entry, Customer, ShopData")
}

Rel(main, appc, "Renders")
Rel(main, sw, "register, postMessage")
Rel(appc, row, "One per customer on the home view")
Rel(appc, imp, "On the home view")
Rel(appc, uselang, "t(), lang")
Rel(appc, usetheme, "theme, toggle")
Rel(appc, store, "State and actions")
Rel(appc, ledger, "Balances, total, order, days, today")
Rel(appc, csv, "CSV text, overdue list")
Rel(appc, images, "Resizes the chosen screenshot")
Rel(row, ledger, "balanceOf, formatRs, reminderHref")
Rel(row, whatsapp, "Remind link, new tab")
Rel(imp, store, "importJson, importError")
Rel(uselang, i18n, "Looks up text")
Rel(uselang, legacy, "readKey, writeKey")
Rel(usetheme, legacy, "readKey, writeKey")
Rel(store, validate, "validateImport")
Rel(store, ledger, "newId")
Rel(store, legacy, "legacyToV2 on first open")
Rel(validate, ledger, "importIds")
Rel(csv, ledger, "balanceOf, signedAmount, order")
Rel(store, ls, "persist: hisaab-shop-v2")
Rel(legacy, ls, "getItem, setItem")

SHOW_LEGEND()
@enduml
